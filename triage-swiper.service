[Unit]
Description=Triage Swiper
After=network-online.target

[Service]
Type=simple
# Adjust the checkout path or --host if needed. Use a Tailscale IP for tailnet access.
ExecStart=/usr/bin/python3 %h/repos/triage-swiper/server.py --host 127.0.0.1
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/ai-talk-picker

[Install]
WantedBy=default.target
